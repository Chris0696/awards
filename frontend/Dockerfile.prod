FROM node:20-alpine

WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer TOUTES les dépendances (pas --production)
RUN npm ci

# Copier le code source
COPY . .

# Créer les dossiers et permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    mkdir -p .next && \
    chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

# Créer le fichier next-env.d.ts
RUN touch /app/next-env.d.ts && \
    chown nextjs:nodejs /app/next-env.d.ts && \
    chmod 664 /app/next-env.d.ts

USER nextjs

EXPOSE 3000

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development

# Mode développement
CMD ["npm", "run", "dev"]
